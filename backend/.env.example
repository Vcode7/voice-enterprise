# ==============================================================================
# FastAPI OCR Backend - Environment Variables
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# OCR Model Configuration (TrOCR Large)
OCR_MODEL_NAME=microsoft/trocr-large-handwritten
# DEVICE can be "auto", "cuda", "cpu", or "mps"
DEVICE=auto

# Chandra 2 Vision OCR Configuration
CHANDRA_MODEL_NAME=datalab-to/chandra-ocr-2
CHANDRA_LOAD_IN_4BIT=true
CHANDRA_QUANTIZATION=3-bit
CHANDRA_MAX_NEW_TOKENS=1856

# Performance & Processing Limits
MAX_PDF_PAGES=50
PDF_DPI=200
BATCH_SIZE=4
ENABLE_LINE_SEGMENTATION=true
MAX_UPLOAD_SIZE_MB=25

# CORS Settings (Comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
