# ==============================================================================
# Voice Entry / Voice ERP - Environment Variables
# ==============================================================================
# Copy this file to .env.local for Next.js:
#   cp .env.example .env.local
# ==============================================================================

# MongoDB Connection URI (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/voice_entry?retryWrites=true&w=majority

# Groq Cloud API Keys (Whisper Speech-to-Text & Fast LLM Structuring)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_FALLBACK1=your_fallback_key_1_here
GROQ_API_KEY_FALLBACK2=your_fallback_key_2_here
GROQ_API_KEY_FALLBACK3=your_fallback_key_3_here

# Google Gemini API (Multimodal Vision / Fallback OCR)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FALLBACK1=your_gemini_fallback_key_1_here
GEMINI_MODEL=gemini-2.0-flash

# Local Python OCR Backend URL (FastAPI with Chandra 2 & PaddleOCR + TrOCR)
PYTHON_OCR_URL=http://127.0.0.1:8000/ocr