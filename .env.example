# ==============================================================================
# Root Environment Configuration for Docker Deployment
# ==============================================================================

# LLM Providers (Optional - Groq will automatically fall back to local Ollama if empty)
GROQ_API_KEY=

# Ollama Local LLM Configuration (accessible from inside Docker via host gateway)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Backend Service
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_BACKEND_URL=http://backend:8000
PADDLE_BACKEND_URL=http://backend:8000/ocr/paddle-vl
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000