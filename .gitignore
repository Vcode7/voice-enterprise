# ==============================================================================
# Voice Entry - Comprehensive .gitignore
# ==============================================================================

# --- Node & Next.js ---
node_modules/
.next/
out/
build/
dist/
.turbo/
tsconfig.tsbuildinfo
next-env.d.ts.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --- Secrets & Local Environment Variables ---
# Never commit credentials or local configuration files to Git!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
*.pem

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
backend/env/
backend/venv/
backend/.venv/
backend/ENV/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Machine Learning Weights, Checkpoints & Large Model Files (>100MB) ---
# Weight checkpoints must not be tracked in git repository
backend/models/trocr_finetuned/
backend/cache/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.tflite
*.joblib
*.pkl

# --- Temporary Files, Uploads & Evaluation Runs ---
scratch/
temp/
tmp/
*.tmp
uploads/
ocr_evaluation_results/
backend/detection/*.png
backend/detection/*.jpg
backend/detection/*.jpeg
!backend/detection/.gitkeep
backend/data/*.db*
backend/data_backup_mongo.json
backend/app_api_backup/

# --- OS & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.agents/
.gemini/
